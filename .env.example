# ============================================================================
# VR Lounge — Environment Configuration
# Copy this file to `.env` to connect across devices/networks via Supabase.
# If left empty, VR Lounge automatically runs in Local Multi-Tab Mode using
# BroadcastChannel + localStorage presence so you can test multi-user VR/Desktop
# watch parties locally with zero setup.
# ============================================================================

# Supabase Realtime (Presence + 20Hz Avatar Pose Broadcast + WebRTC Signaling)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional TURN Server for WebRTC across strict NATs / cellular networks
# (Public Google STUN servers are configured automatically by default)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional YouTube / External Stream Resolver Endpoint for Mode 2 (Direct Sync)
# Example: https://your-resolver.example.com/resolve?url=
# Expects JSON `{ "streamUrl": "https://.../manifest.m3u8", "title": "..." }`
# Note: Netflix, Disney+, and standard YouTube tabs work out of the box via
# Mode 1 ("Share Browser Tab" using WebRTC getDisplayMedia).
VITE_YOUTUBE_PROXY_URL=
