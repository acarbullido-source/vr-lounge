# ============================================================================
# VR Lounge — Environment Configuration
# Copy this file to `.env` for local builds, or set these as GitHub Actions
# Repository Secrets / Variables for automatic GitHub Pages deployments.
# If left empty, VR Lounge automatically runs in Zero-Config Cloud Relay mode.
# ============================================================================

# 1. Supabase Realtime (Presence + 20Hz Avatar Pose Broadcast + WebRTC Signaling)
# Supports both modern `sb_publishable_...` keys and legacy JWT `anon` keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Metered.ca Free OpenRelay TURN (20 GB/mo free — bypasses strict NATs/hotspots)
# Set VITE_METERED_API_KEY (and optionally VITE_METERED_DOMAIN if using a custom
# `<appname>.metered.live` subdomain, or full URL in VITE_METERED_TURN_URL).
VITE_METERED_API_KEY=
VITE_METERED_DOMAIN=
VITE_METERED_TURN_URL=

# Optional Static TURN Server fallback (if not using Metered dynamic credentials)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# 3. Optional Custom Piped / Invidious Relay URL for In-VR YouTube
# Leave blank to use automatic latency-ranked community relay racing & failover.
VITE_YOUTUBE_PROXY_URL=
